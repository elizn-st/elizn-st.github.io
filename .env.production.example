# Template for a real Firebase project. Copy to .env.production (gitignored)
# or set these in the build environment.
#
# Values come from: Firebase Console -> Project settings -> Your apps -> SDK
# setup and configuration -> Config.
#
# None of these are secrets. The Firebase web config is compiled into the
# client bundle by design and is a project identifier, not a credential --
# which is exactly why firestore.rules is the real perimeter.
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_APP_ID=

# Optional: point a real project id at the local emulators instead of the cloud.
# VITE_FIREBASE_EMULATORS=true
