# Offline emulator config. Committed on purpose: a "demo-" project id has no
# cloud counterpart, so none of these are secrets and none can reach a real
# Firebase project. src/lib/firebase.ts sees the prefix and routes every call
# to the local emulators.
#
# A real project's values belong in .env.production (gitignored) or the build
# environment -- never here.
VITE_FIREBASE_PROJECT_ID=demo-adpa
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-adpa.firebaseapp.com
