rules_version = '2';

// The default posture here is deny. Every collection opts in explicitly below,
// so a collection introduced later stays unreadable until someone writes a rule
// for it -- a loud development error rather than data quietly readable.
//
// Two things bypass these rules entirely, which is why the client-write rules
// can stay closed without blocking anyone who legitimately needs to edit:
//
//   * the Firebase Console, which acts with project IAM privileges -- so a
//     customer granted Console access edits documents directly, and every
//     app instance sees it live through onSnapshot; and
//   * the Admin SDK, used by scripts/seed.ts and any pipeline writes.
//
// Rules govern the client SDK only: the web app, and anyone who lifts the
// (public, non-secret) web config out of the bundle and queries the database
// themselves. Assume the latter will happen -- this repository is public.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Being signed in is NOT enough to read anything.
    //
    // The web config ships in a public bundle and email/password sign-up is
    // open by default, so "signed in" is available to anyone who wants it.
    // Reading pricing data additionally requires a `portalAccess` custom
    // claim, granted out of band by scripts/grant-access.ts. That matches how
    // the portal actually works -- the login screen says access is provisioned
    // by an administrator -- and it means a self-registered account sees
    // nothing.
    function hasPortalAccess() {
      return signedIn() && request.auth.token.portalAccess == true;
    }

    // Set as a custom claim, never read from a document: a role document would
    // mean a get() inside every rule evaluation, billed as a read on every
    // access.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ---- org-wide data -------------------------------------------------------
    // `recommendations`, `decisions` and `rules` are one document per row, so
    // they can be queried and edited individually. `analytics`, `content` and
    // `config` hold documents that are always read whole -- one per chart series
    // or per screen's copy -- because Firestore bills per document read.
    //
    // Approving or rejecting a recommendation is a decision, not an edit: it
    // belongs in `decisions` as a new document, so `recommendations` itself
    // takes no client writes.

    match /recommendations/{recommendationId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    match /decisions/{decisionId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    // Guardrail rules are read by everyone with portal access and changed only
    // by Admin -- which is the whole point of the Rules screen being read-only
    // for a reviewer. A proposed change is a request, not an edit, so nothing
    // here takes a client write.
    match /rules/{ruleId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    match /analytics/{documentId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    match /content/{documentId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    match /config/{documentId} {
      allow read: if hasPortalAccess();
      allow write: if isAdmin();
    }

    // ---- per-user state ------------------------------------------------------
    // A user's own subtree needs only ownership, not portal access: it holds
    // their notification read state and chat threads, which are theirs whether
    // or not they have been provisioned.

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
  }
}
